{
  "name": "openbastion-docs",
  "version": "0.0.1",
  "private": true,
  "description": "Site de documentation publique du projet OpenBastion",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 3000 --host 0.0.0.0",
    "docs:check": "npm run docs:check:markdown && npm run docs:check:links",
    "docs:check:markdown": "node scripts/check-docs-markdown.mjs",
    "docs:check:links": "node scripts/check-docs-links.mjs",
    "security:audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "mermaid": "^11.4.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "overrides": {
    "vite": "6.4.6",
    "katex": "0.18.2"
  }
}
